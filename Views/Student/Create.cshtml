@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Thêm Sinh Viên mới";
}
<h2>Thêm sinh viên mới</h2>
<hr>
<div class = "row">
    <div class = "col-md-6">
        <form asp-action="Create" method="post">
            <div class = "mb-3">
                <label asp-for="FullName" class= "form-label">Họ Tên</label>
                <input asp-for="FullName" class ="form-control">
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>
            <div class = "mb-3">
                <label asp-for="Address" class= "form-label">Địa chỉ</label>
                <input asp-for="Address" class ="form-control">
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class = "mb-3">
                <label asp-for="Birthday" class= "form-label">Ngày sinh</label>
                <input asp-for="Birthday" class ="form-control" type="date">
                <span asp-validation-for="Birthday" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EnrollmentYear" class="form-label">Năm nhập học</label>
                <input asp-for="EnrollmentYear" class="form-control" type="number" value="2028" />
                <span asp-validation-for="EnrollmentYear" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TrainingType" class="form-label">Hệ đào tạo</label>
                <select asp-for="TrainingType" class="form-select">
                    <option value="21">21 - Đại học Chính quy (4.5 năm)</option>
                    <option value="22">22 - Đại học Chất lượng cao</option>
                    <option value="25">25 - Liên thông / Vừa làm vừa học</option>
                </select>
                <span asp-validation-for="TrainingType" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="FacultyId" class="form-label">Khoa / Ngành</label>
                <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.FacultyList">
                    <option value="">-- Chọn Khoa/Ngành --</option>
                </select>
                <span asp-validation-for="FacultyId" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu</button>
        </form> 

    </div>
</div>